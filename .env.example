# Variables de entorno

Este archivo sirve como plantilla para configurar el entorno local del proyecto.
No subas un archivo `.env` real con secretos en el repositorio.

# --- General ---
NODE_ENV=development
PORT=3000

# --- JWT / autenticación ---
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=7d

# --- Handshake interno / servicios ---
DB_HANDSHAKE_SECRET=change-me-too

# --- PostgreSQL ---
POSTGRES_DB=viking_clan_wars
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DB=viking_clan_wars_analytics

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://minio:9000

# --- Frontend ---
FRONTEND_PORT=4200

# --- Middle server ---
MIDDLE_SERVER_PORT=3000
API_BASE_URL=http://middle-server:3000

# --- DB server ---
DB_SERVER_PORT=8080
DB_SERVER_BASE_URL=http://db-server:8080
